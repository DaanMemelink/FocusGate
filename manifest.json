{
  "manifest_version": 3,
  "name": "Focus Gate",
  "version": "1.0.0",
  "description": "Put deliberate friction between you and distracting sites, instead of hard-blocking them.",
  "permissions": [
    "storage",
    "webNavigation"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "js": [
        "src/content/monitor.js"
      ]
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Focus Gate"
  }
}
