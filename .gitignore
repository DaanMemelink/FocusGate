# Design handoff bundle — reference material, not part of the extension.
design_handoff_focus_gate/

# Bundled clips. Media you did not create should not be redistributed, so the
# repo ships none — drop your own .mp4 files here and list them in
# config/defaults.json under clipFiles. tools/package.mjs excludes them anyway.
src/assets/clips/*
!src/assets/clips/.gitkeep

# Local config override — your own clip paths and any settings you want to
# differ from what ships. See config/defaults.json.
config/local.json

# Packaging output
dist/
build/
*.zip
*.crx
*.pem

# Editor / IDE
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db

# Logs and local env
*.log
.env
.env.*
